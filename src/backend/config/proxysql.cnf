datadir="/var/lib/proxysql"

admin_variables=
{
    admin_credentials="admin:admin"
    mysql_ifaces="0.0.0.0:6032"
}

mysql_variables=
{
    interfaces="0.0.0.0:6033"
    threads=4
    max_connections=2048
    default_query_delay=0
    default_query_timeout=36000000
}

mysql_servers =
(
    { address="mysql-primary" , port=3306 , hostgroup=0, weight=1000, max_connections=500, max_replication_lag=10, comment="PRIMARY" },
    { address="mysql-replica-1" , port=3306 , hostgroup=1, weight=100, max_connections=500, max_replication_lag=10, comment="REPLICA 1" },
    { address="mysql-replica-2" , port=3306 , hostgroup=1, weight=100, max_connections=500, max_replication_lag=10, comment="REPLICA 2" },
    { address="mysql-replica-3" , port=3306 , hostgroup=1, weight=100, max_connections=500, max_replication_lag=10, comment="REPLICA 3" }
)

mysql_users =
(
    { username="app_user", password="app_password", default_hostgroup=0, active=1, transaction_persistent=1, max_connections=500 }
)

mysql_query_rules =
(
    { rule_id=1, active=1, match_pattern="^SELECT.*FOR[[:space:]]+UPDATE", destination_hostgroup=0, apply=1 },
    { rule_id=2, active=1, match_pattern="^SELECT", destination_hostgroup=1, apply=1 },
    { rule_id=3, active=1, match_pattern="^(INSERT|UPDATE|DELETE|REPLACE|CREATE|DROP|ALTER|TRUNCATE)", destination_hostgroup=0, apply=1 }
)