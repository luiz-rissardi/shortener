
docker compose down -v
docker compose up -d
docker compose ps
docker compose logs cluster-setup
docker exec proxysql mysql -uadmin -padmin -P6032 -e "SELECT 1;"
docker exec proxysql mysql -uadmin -padmin -P6032 -e "UPDATE global_variables SET variable_value='0.0.0.0:6033' WHERE variable_name='mysql-interfaces'; LOAD MYSQL VARIABLES TO RUNTIME; SAVE MYSQL VARIABLES TO DISK;"
docker exec proxysql mysql -uadmin -padmin -P6032 -e "UPDATE global_variables SET variable_value='0.0.0.0:6032' WHERE variable_name='admin-mysql_ifaces'; LOAD ADMIN VARIABLES TO RUNTIME; SAVE ADMIN VARIABLES TO DISK;"
docker exec proxysql mysql -uadmin -padmin -P6032 -e "DELETE FROM mysql_servers; INSERT INTO mysql_servers (hostgroup_id,hostname,port,status,weight,max_connections,max_replication_lag,comment) VALUES (0,'mysql-primary',3306,'ONLINE',1000,500,10,'PRIMARY'),(1,'mysql-replica-1',3306,'ONLINE',100,500,10,'REPLICA 1'),(1,'mysql-replica-2',3306,'ONLINE',100,500,10,'REPLICA 2'),(1,'mysql-replica-3',3306,'ONLINE',100,500,10,'REPLICA 3'); LOAD MYSQL SERVERS TO RUNTIME; SAVE MYSQL SERVERS TO DISK;"
docker exec proxysql mysql -uadmin -padmin -P6032 -e "DELETE FROM mysql_users; INSERT INTO mysql_users (username,password,active,default_hostgroup,max_connections,transaction_persistent) VALUES ('app_user','app_password',1,0,500,1); LOAD MYSQL USERS TO RUNTIME; SAVE MYSQL USERS TO DISK;"
docker exec proxysql mysql -uadmin -padmin -P6032 -e "DELETE FROM mysql_query_rules; INSERT INTO mysql_query_rules (rule_id,active,match_pattern,destination_hostgroup,apply) VALUES (1,1,'^SELECT.*FOR[[:space:]]+UPDATE',0,1),(2,1,'^SELECT',1,1),(3,1,'^(INSERT|UPDATE|DELETE|REPLACE|CREATE|DROP|ALTER|TRUNCATE)',0,1); LOAD MYSQL QUERY RULES TO RUNTIME; SAVE MYSQL QUERY RULES TO DISK;"
docker exec proxysql mysql -uadmin -padmin -P6032 -e "SELECT variable_name,variable_value FROM global_variables WHERE variable_name IN ('mysql-interfaces','admin-mysql_ifaces');"
docker exec proxysql mysql -uadmin -padmin -P6032 -e "SELECT hostgroup_id,hostname,port,status,weight FROM runtime_mysql_servers ORDER BY hostgroup_id,hostname;"
docker exec proxysql mysql -uadmin -padmin -P6032 -e "SELECT username,password,active,default_hostgroup FROM mysql_users;"
docker exec proxysql mysql -h127.0.0.1 -P6033 -uapp_user -papp_password -e "SELECT 1 AS connected;"
docker exec proxysql mysql -h127.0.0.1 -P6033 -uapp_user -papp_password -e "SELECT @@hostname AS backend, @@server_id AS server_id, @@read_only AS read_only;"
